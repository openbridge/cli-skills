# Hooks and shell scripts are parsed by bash even on Windows — CRLF breaks them.
*.sh        text eol=lf
*.cmd       text eol=lf
hooks/*     text eol=lf

*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.py        text eol=lf

*.png binary
*.jpg binary
*.svg text eol=lf
