#!/usr/bin/env bash
# SessionStart hook: inject the bootstrap skill into every new session.
#
# Skills are only useful if the agent knows they exist. Everything in skills/ is
# loaded on demand, except the bootstrap skill, which is pushed into context here so
# the agent starts every session already knowing to look for the rest.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
BOOTSTRAP="${PLUGIN_ROOT}/skills/using-skills/SKILL.md"
PLUGIN_JSON="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

if [ ! -r "$BOOTSTRAP" ]; then
  # Emit nothing rather than a broken injection. A silent no-op degrades to "skills
  # are opt-in"; a malformed payload can break the session outright.
  echo "session-start: cannot read ${BOOTSTRAP}" >&2
  exit 0
fi

bootstrap_content="$(cat "$BOOTSTRAP")"

# The collection name is branding, and branding is the one thing a fork must change.
# Read it from plugin.json so renaming is a one-field edit instead of a find-replace
# across hook, manifests, and docs.
#
# Anchored to a top-level key (0-2 spaces of indent, which is what we ship) rather
# than the first "name" anywhere — the latter silently picks up author.name when a
# fork reorders fields. No jq: it is absent on Windows git-bash and in many hook
# sandboxes, and a missing parser here would break every session.
read_plugin_name() {
  [ -r "$PLUGIN_JSON" ] || return 1
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^[[:space:]]{0,2}\"name\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
      return 0
    fi
  done < "$PLUGIN_JSON"
  return 1
}

# Falls back to the directory name, which tracks a repository rename on its own.
collection_name="$(read_plugin_name || true)"

# Plugin names are identifiers. Anything outside that charset means the line regex
# above stopped on an escape sequence and captured a fragment, so prefer the
# directory name over printing half a name into every session.
if ! [[ "$collection_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
  collection_name="$(basename "$PLUGIN_ROOT")"
fi

# JSON-escape via bash parameter substitution. Each ${s//old/new} is one C-level
# pass, so this stays fast on multi-KB skills. Backslash MUST be first — escaping it
# after the quotes would double-escape the backslashes this function just added.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

escaped="$(escape_for_json "$bootstrap_content")"
# plugin.json is fork-editable, so its name reaches this JSON payload as untrusted
# text and gets the same escaping as the skill body.
escaped_name="$(escape_for_json "$collection_name")"

context="<EXTREMELY_IMPORTANT>\nYou have ${escaped_name}.\n\nWhat follows is the full text of your 'using-skills' skill — how to find and invoke the rest. Load any other skill on demand with your harness's skill tool.\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

# Each harness reads a different field, and some read more than one without
# deduplicating — so emit exactly one shape, chosen by harness.
#
# The branches are ordered most-specific first, because the environment markers
# overlap: Cursor and Copilot CLI both run the Claude Code plugin and may set
# CLAUDE_PLUGIN_ROOT too. Testing for it first would swallow them both and emit a
# shape neither reads — a bootstrap that vanishes with no error anywhere.
#
# printf rather than a heredoc: bash 5.3+ can hang on heredocs in hook context.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor: snake_case, top-level.
  printf '{\n  "additional_context": "%s"\n}\n' "$context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code: nested under hookSpecificOutput. It reads additional_context as
  # well and does not deduplicate, so this branch must emit only the one field.
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
else
  # Copilot CLI (sets COPILOT_CLI=1) and any unknown harness: SDK-standard
  # top-level field. Better than emitting nothing, since a wrong-but-visible
  # payload is far easier to debug than silence.
  printf '{\n  "additionalContext": "%s"\n}\n' "$context"
fi

exit 0
